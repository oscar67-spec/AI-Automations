    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cleanedLeads = [];\n\nfor (const item of items) {\n  const tweet = item.json;\n  \n  // Skip if no user data\n  if (!tweet.author_id && !tweet.user) continue;\n  \n  const tweetText = tweet.text || '';\n  if (!tweetText) continue;\n  \n  // Filter out job postings\n  const textLower = tweetText.toLowerCase();\n  const badWords = ['hiring', 'job opening', 'we are hiring', 'join our team'];\n  if (badWords.some(word => textLower.includes(word))) continue;\n  \n  cleanedLeads.push({\n    json: {\n      tweet_id: tweet.id,\n      tweet_text: tweetText.substring(0, 280),\n      tweet_url: `https://twitter.com/user/status/${tweet.id}`,\n      author_id: tweet.author_id,\n      found_date: new Date().toISOString().split('T')[0]\n    }\n  });\n}\n\nreturn cleanedLeads;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3936,
        544
      ],
      "id": "9c323046-7d6c-4316-ab1b-65382eb7fe21",
