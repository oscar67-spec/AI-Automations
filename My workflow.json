    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const user = $input.item.json;\nconst tweet = $('Code in JavaScript').item.json;\nconst bio = user.description || user.bio || '';\n\nconst urlRegex = /(https?:\\/\\/[^\\s]+)|(www\\.[^\\s]+)|([a-zA-Z0-9-]+\\.(com|io|co|net|org|ai|app))/gi;\nconst matches = bio.match(urlRegex) || [];\n\nlet domain = '';\n\nfor (let match of matches) {\n  try {\n    match = match.replace(/[.,;!?)]+$/, '');\n    if (!match.startsWith('http')) {\n      match = 'https://' + match;\n    }\n    \n    const url = new URL(match);\n    domain = url.hostname.replace('www.', '');\n    \n    const skipDomains = ['twitter.com', 'x.com', 'linkedin.com', 't.co'];\n    if (!skipDomains.some(skip => domain.includes(skip))) {\n      break;\n    } else {\n      domain = '';\n    }\n  } catch (e) {\n    continue;\n  }\n}\n\nreturn {\n  json: {\n    tweet_id: tweet.tweet_id,\n    tweet_text: tweet.tweet_text,\n    tweet_url: tweet.tweet_url,\n    found_date: tweet.found_date,\n    name: user.name || user.username,\n    username: user.username,\n    bio: bio,\n    followers: user.public_metrics?.followers_count || 0,\n    domain: domain,\n    has_domain: domain ? true : false\n  }\n};"
      },
